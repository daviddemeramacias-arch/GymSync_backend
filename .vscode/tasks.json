{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GymSync: verificar MySQL y Docker",
      "type": "shell",
      "command": "powershell -NoProfile -Command \"Get-Service MySQL,com.docker.service | Select-Object Name,Status,StartType\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "GymSync: seed (usuarios demo)",
      "type": "shell",
      "command": "npm run seed",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": { "PATH": "C:\\Users\\Deivis_Pc\\AppData\\Local\\node20;${env:PATH}" }
      },
      "problemMatcher": []
    },
    {
      "label": "GymSync: backend (build + start)",
      "type": "shell",
      "command": "npm run build; npm start",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": { "PATH": "C:\\Users\\Deivis_Pc\\AppData\\Local\\node20;${env:PATH}" }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "GymSync: admin Angular :4200",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/admin-web" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "GymSync: preview :5173",
      "type": "shell",
      "command": "python -m http.server 5173",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "GymSync: PWA socio :4201",
      "type": "shell",
      "command": "python -m http.server 4201",
      "options": { "cwd": "${workspaceFolder}/pwa-socio" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "GymSync: INICIAR TODO",
      "dependsOrder": "parallel",
      "dependsOn": [
        "GymSync: backend (build + start)",
        "GymSync: admin Angular :4200",
        "GymSync: preview :5173",
        "GymSync: PWA socio :4201"
      ],
      "problemMatcher": []
    },
    {
      "label": "GymSync: detener servidores 3000/4200/4201/5173",
      "type": "shell",
      "command": "powershell -NoProfile -Command \"Get-NetTCPConnection -State Listen | Where-Object { $_.LocalPort -in 3000,4200,4201,5173 } | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
